# To enable GitHub Actions, move this file to .github/workflows/ci.yml:
#   git mv docs/ci.yml.example .github/workflows/ci.yml
#   git commit -m "Enable CI" && git push
# Pushing a workflow file requires a token/login with the `workflow` scope
# (e.g. `gh auth refresh -h github.com -s workflow`).
name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"
      - name: Tests (fully offline - no API keys in CI)
        run: pytest -q
      - name: Smoke eval
        run: python -m marag.eval
